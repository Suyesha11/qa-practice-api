        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set(\"firstname\",\"Guest_\"+Date.now());\r",
                  "\r",
                  "const tomorrow = new Date();\r",
                  "tomorrow.setDate(tomorrow.getDate()+1);\r",
                  "pm.variables.set(\"checkinDate\",tomorrow.toISOString().slice(0,10))\r",
                  "\r",
                  "console.log(\"Generated checkin date:\", pm.variables.get(\"checkinDate\"));\r",
                  "\r",
                  "const template = \"Booking for {{firstname}} on {{checkinDate}}\";\r",
                  "const resolved = pm.variables.replaceIn(template);\r",
                  "console.log(\"Resolved template:\", resolved);\r",
                  "\r",
                  "pm.sendRequest({\r",
                  "    url: pm.variables.replaceIn('{{base_url}}/health'),\r",
                  "    method: 'GET'\r",
                  "}, function (err, response) {\r",
                  "    if (err) {\r",
                  "        console.error('Health check failed:', err);\r",
                  "    } else {\r",
                  "        console.log('Server health before booking creation:', response.json().status);\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "pm.test(\"Booking created\",function(){\r",
                  "    pm.response.to.have.status(201);\r",
                  "})\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "pm.environment.set(\"bookingId\", jsonData.id);\r",
                  "if (jsonData.totalPrice < 100) {\r",
                  "    console.log(\"Price under 100 — routing straight to Delete Booking, skipping Get\");\r",
                  "    pm.execution.setNextRequest(\"Delete Booking\");\r",
                  "} else {\r",
                  "    console.log(\"Price is 100+, proceeding normally to Get Booking By ID\");\r",
                  "}\r",
                  "\r",
                  "\r",
                  "\r",
                  "console.log(\"Booking created with ID:\" , jsonData.id)\r",
                  "\r",
                  "console.log(\"Raw text body:\",pm.response.text());\r",
                  "console.log(\"Response size (bytes):\", pm.response.responseSize);\r",
                  "console.log(\"Content-Type header:\", pm.response.headers.get(\"Content-Type\"));\r",
                  "console.log(\"Has Etag header:\", pm.response.headers.has(\"Etag\"));\r",
                  "console.log(\"All headers\", pm.response.headers.all());\r",
                  "\r",
                  "const location = pm.response.headers.get(\"Location\");\r",
                  "console.log(\"Location header:\", location);\r",
                  "pm.test(\"Location header points to the new booking\", function () {\r",
                  "    pm.expect(location).to.include(`/bookings/${pm.response.json().id}`);\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\": \"{{firstname}}\",\r\n    \"lastname\": \"Automation\",\r\n    \"totalPrice\": 180,\r\n    \"depositPaid\": true,\r\n    \"roomType\": \"double\",\r\n    \"bookingDates\": {\r\n      \"checkin\": \"{{checkinDate}}\",\r\n      \"checkout\": \"2026-09-10\"\r\n    }\r\n  }",
              "options": {
