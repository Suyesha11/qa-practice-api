        {
          "name": "Get All Bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\",function(){\r",
                  "    pm.response.to.have.status(200);\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Response time is under 500ms\", ()=>{\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(500)\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Response has data and pagination\",()=>{\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property('data');\r",
                  "    pm.expect(jsonData).to.have.property('pagination');\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Data is an array\",function(){\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.data).to.be.an('array')\r",
                  "})\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "//Deep quality-checks every nested field matches exactly , not just \"Has this property\"\r",
                  "pm.test(\"First booking has correct shape\", function(){\r",
                  "    pm.expect(jsonData.data[0]).to.have.all.keys(\r",
                  "        'id',\r",
                  "        'firstname',\r",
                  "        'lastname',\r",
                  "        'totalPrice',\r",
                  "        'depositPaid',\r",
                  "        'roomType',\r",
                  "        'bookingDates',\r",
                  "        'additionalNeeds',\r",
                  "        'ownerId',\r",
                  "        'createdAt'    );\r",
                  "});\r",
                  "\r",
                  "//Array contents - checking an array includes a specific value\r",
                  "pm.test(\"Room types are all valid\",function(){\r",
                  "    const validTypes= [ 'single' ,'double' , 'twin' , 'suite'];\r",
                  "    jsonData.data.forEach(booking=>{\r",
                  "        pm.expect(validTypes).to.include(booking.roomType);\r",
                  "    })})\r",
                  "\r",
                  "//Regex matching - validating a string follows a pattern\r",
                  "pm.test(\"Checkin date matches YYYY-MM-DD format\",function(){\r",
                  "    pm.expect(jsonData.data[0].bookingDates.checkin).to.match(/^\\d{4}-\\d{2}-\\d{2}$/)\r",
                  "})\r",
                  "\r",
                  "//Numeric comparisons beyond simple equality \r",
                  "pm.test(\"Total price is a sane positive number\",function (){\r",
                  "    pm.expect(jsonData.data[0].totalPrice).to.be.a('number').and.to.be.above(0);\r",
                  "})\r",
                  "\r",
                  "//Negation - proving something is absent (important for security/exposure checks)\r",
                  "pm.test(\"Response does not leak internal fields\",function(){\r",
                  "    pm.expect(jsonData.data[0]).to.not.have.property('password');\r",
                  "     pm.expect(jsonData.data[0]).to.not.have.property('__v');\r",
                  "})"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/bookings",
